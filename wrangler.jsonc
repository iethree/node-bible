{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bible",
	"main": "src/server/index.ts",
	"compatibility_date": "2026-10-01",
	"observability": { "enabled": true },
	"routes": [{ "pattern": "bible.infopanel.org", "custom_domain": true }],
	// The Vite client is built into ./dist/client before every dev/deploy.
	"build": {
		"command": "bun run build"
	},
	"assets": {
		"directory": "./dist/client",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bible",
			"database_id": "ff968c84-9197-4ba4-9a0d-72e5749e8d26",
			"migrations_dir": "migrations"
		}
	]
	// Secret: ESVTOKEN (`wrangler secret put ESVTOKEN`; locally in .dev.vars)
}
