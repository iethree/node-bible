{
	"name": "infopanel-bible",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wrangler dev",
		"dev:client": "vite",
		"build": "vite build",
		"deploy": "wrangler deploy",
		"db:migrate:local": "wrangler d1 migrations apply bible --local",
		"db:migrate": "wrangler d1 migrations apply bible --remote",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
		"test": "bun test",
		"lint": "biome check .",
		"format": "biome format --write .",
		"fix": "biome check --write ."
	},
	"dependencies": {
		"idb": "^8.0.3",
		"preact": "^10.25.4",
		"swr": "^2.4.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@cloudflare/workers-types": "^5.20261024.1",
		"@happy-dom/global-registrator": "^20.9.0",
		"@preact/preset-vite": "^2.9.3",
		"@tailwindcss/vite": "^4.0.0",
		"@types/bun": "^1.1.18",
		"fake-indexeddb": "^6.2.5",
		"happy-dom": "^20.9.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.7.3",
		"vite": "^6.0.7",
		"wrangler": "^4.152.0"
	},
	"license": "MIT"
}
